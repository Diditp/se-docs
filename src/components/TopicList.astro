---
import { getCollection } from 'astro:content';
import { DOMAINS, LEVELS } from '../data/catalog.mjs';

interface Props { domain: string }
const d = DOMAINS.find((x) => x.id === Astro.props.domain);
if (!d) throw new Error(`Domain tidak dikenal: ${Astro.props.domain}`);

const docs = await getCollection('docs');
const status = new Map(docs.map((e) => [e.id, (e.data as any).status ?? 'complete']));
const groups = d.groups ?? [{ label: 'Topik', dir: '', topics: d.topics ?? [] }];
const rows = groups.map((g) => ({
  label: g.label,
  topics: g.topics.map(([slug, title, level]) => {
    const path = [d.dir, g.dir, slug].filter(Boolean).join('/');
    return { path, title, level, st: status.get(path) ?? 'stub' };
  }),
}));
const all = rows.flatMap((r) => r.topics);
const written = all.filter((t) => t.st !== 'stub').length;
---

<div class="tl not-content" data-topiclist data-slugs={JSON.stringify(all.map((t) => t.path))}>
  <div class="summary">
    <div><strong>{all.length}</strong> topik · <strong>{written}</strong> sudah ditulis · <strong data-done>0</strong> sudah Anda pelajari</div>
    <div class="bar"><span data-bar style="width:0%"></span></div>
  </div>
  {rows.map((r) => (
    <section>
      {d.groups && <h3>{r.label}</h3>}
      <ul>
        {r.topics.map((t) => (
          <li data-slug={t.path}>
            <span class="chk" aria-hidden="true">○</span>
            <a href={`/${t.path}/`}>{t.title}</a>
            <span class={`lv lv-${t.level}`}>{LEVELS[t.level]}</span>
            {t.st === 'stub' ? <span class="st">stub</span> : t.st === 'draft' ? <span class="st draft">draft</span> : <span class="st ok">lengkap</span>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<script>
  import { load } from '../scripts/store';
  function paint() {
    document.querySelectorAll<HTMLElement>('[data-topiclist]').forEach((el) => {
      const d = load();
      const slugs: string[] = JSON.parse(el.dataset.slugs!);
      let done = 0;
      el.querySelectorAll<HTMLElement>('li[data-slug]').forEach((li) => {
        const ok = !!d.learned[li.dataset.slug!];
        if (ok) done++;
        li.classList.toggle('done', ok);
        li.querySelector('.chk')!.textContent = ok ? '✓' : '○';
      });
      el.querySelector('[data-done]')!.textContent = String(done);
      (el.querySelector('[data-bar]') as HTMLElement).style.width = `${Math.round((done / slugs.length) * 100)}%`;
    });
  }
  paint();
  window.addEventListener('sekb:change', paint);
</script>

<style>
  .tl { margin-top: 1.5rem; }
  .summary { font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); margin-bottom: 1rem; }
  .bar { height: 6px; border-radius: 99px; background: var(--sl-color-gray-6); margin-top: 0.5rem; overflow: hidden; }
  .bar span { display: block; height: 100%; background: var(--sl-color-accent); transition: width 0.3s; }
  h3 { font-size: var(--sl-text-base); color: var(--sl-color-white); margin: 1.5rem 0 0.5rem; }
  ul { list-style: none; padding: 0; margin: 0; border: 1px solid var(--sl-color-gray-5); border-radius: 0.6rem; overflow: hidden; }
  li { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0.8rem; font-size: var(--sl-text-sm); }
  li + li { border-top: 1px solid var(--sl-color-gray-6); }
  li a { flex: 1; color: var(--sl-color-white); text-decoration: none; }
  li a:hover { color: var(--sl-color-accent-high); text-decoration: underline; }
  .chk { width: 1rem; color: var(--sl-color-gray-4); }
  li.done .chk { color: var(--sl-color-green-high); }
  li.done a { color: var(--sl-color-gray-2); }
  .lv, .st { font-size: var(--sl-text-xs); padding: 0 0.45rem; border-radius: 99px; border: 1px solid var(--sl-color-gray-5); color: var(--sl-color-gray-3); white-space: nowrap; }
  .lv-b { color: var(--sl-color-green-high); }
  .lv-i { color: var(--sl-color-blue-high); }
  .lv-a { color: var(--sl-color-purple-high); }
  .st.ok { background: var(--sl-color-green-low); color: var(--sl-color-green-high); border-color: transparent; }
  .st.draft { background: var(--sl-color-orange-low); color: var(--sl-color-orange-high); border-color: transparent; }
  @media (max-width: 40rem) { .lv { display: none; } }
</style>
