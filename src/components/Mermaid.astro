---
// Diagram Mermaid dirender di browser (lazy-load) dan mengikuti tema light/dark.
// Pemakaian di .mdx:  <Mermaid code={`flowchart LR\n  A --> B`} />
interface Props { code: string; caption?: string }
const { code, caption } = Astro.props;
---

<figure class="mmd not-content">
  <pre class="mermaid-src" data-mermaid>{code}</pre>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  async function renderAll() {
    const nodes = [...document.querySelectorAll<HTMLElement>('[data-mermaid]')];
    if (!nodes.length) return;
    const { default: mermaid } = await import('mermaid');
    const dark = document.documentElement.dataset.theme === 'dark';
    mermaid.initialize({ startOnLoad: false, theme: dark ? 'dark' : 'default', securityLevel: 'strict', fontFamily: 'Inter, ui-sans-serif, system-ui, Segoe UI, Roboto, sans-serif' });
    for (const [i, el] of nodes.entries()) {
      const src = el.dataset.src ?? el.textContent ?? '';
      el.dataset.src = src;
      try {
        const { svg } = await mermaid.render(`mmd-${i}-${Date.now()}`, src);
        el.innerHTML = svg;
        el.classList.add('rendered');
      } catch (e) {
        console.warn('Mermaid gagal dirender', e);
      }
    }
  }
  renderAll();
  // Render ulang saat tema berganti
  new MutationObserver(renderAll).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>

<style>
  .mmd { margin: 1.5rem 0; padding: 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.75rem; overflow-x: auto; }
  .mermaid-src { margin: 0; background: none; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); white-space: pre; }
  .mermaid-src.rendered { display: flex; justify-content: center; white-space: normal; font-family: var(--sl-font); }
  figcaption { text-align: center; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); margin-top: 0.5rem; }
</style>
